{
    "name": "noid",
    "version": "0.16.0",
    "description": "Persistent AI bots that share one computer: a durable, multiplayer, mobile-first web app for Pi agents, built on Pi Pocket and Pi Durable",
    "private": true,
    "type": "module",
    "license": "MIT",
    "author": "noid contributors",
    "contributors": [
        "Tanner Middleton (Pi Pocket, https://github.com/TannerMidd/pi-pocket)"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/noid-one/noid-bot.git"
    },
    "homepage": "https://github.com/noid-one/noid-bot#readme",
    "bugs": {
        "url": "https://github.com/noid-one/noid-bot/issues"
    },
    "bin": {
        "pi-pocket": "bin/pi-pocket.js"
    },
    "engines": {
        "node": ">=22.19"
    },
    "scripts": {
        "start": "node bin/pi-pocket.js",
        "dev": "node bin/pi-pocket.js --cwd .",
        "check": "tsc --noEmit -p . && node test/types-file.ts && node docs-site/check-reference.mjs",
        "test": "node --test --test-timeout=120000 test/*.test.ts",
        "format": "eslint --fix . && prettier --write .",
        "format:check": "prettier --check . && eslint .",
        "lint": "eslint ."
    },
    "dependencies": {
        "@earendil-works/chord": "1.3.0",
        "@earendil-works/pi-ai": "1.3.0",
        "@earendil-works/pi-codemode": "1.3.0",
        "@earendil-works/pi-coding-agent": "1.3.0",
        "@earendil-works/pi-durable": "1.3.0",
        "@earendil-works/pi-env": "1.3.0",
        "@earendil-works/pi-mcp": "1.3.0",
        "@xterm/addon-fit": "0.11.0",
        "@xterm/xterm": "6.0.0",
        "dompurify": "^3.4.16",
        "htm": "^3.1.1",
        "jiti": "2.7.0",
        "marked": "^18.1.0",
        "preact": "^11.0.1",
        "qrcode": "^1.5.4",
        "undici": "8.10.2"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/node": "^26.6.5",
        "@types/qrcode": "^1.5.6",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "10.1.8",
        "prettier": "3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1"
    }
}
